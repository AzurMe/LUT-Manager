{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lut-manager.local/schemas/lut-record.schema.json",
  "title": "LUT Manager Record",
  "type": "object",
  "required": [
    "id",
    "name",
    "fileName",
    "cameraCompatibility",
    "author",
    "colorStyle",
    "tags",
    "look",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable app-generated id."
    },
    "name": {
      "type": "string"
    },
    "fileName": {
      "type": "string",
      "description": "Original LUT file name. The LUT file itself is not modified."
    },
    "cameraCompatibility": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "brand",
          "models",
          "profile",
          "category"
        ],
        "properties": {
          "brand": {
            "type": "string"
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "profile": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        }
      }
    },
    "author": {
      "type": "string"
    },
    "colorStyle": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "description": "Typed tags used for search and filtering.",
      "items": {
        "type": "object",
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "cameraCategory",
              "cameraBrand",
              "cameraModel",
              "captureProfile",
              "function",
              "style",
              "shadowTone",
              "highlightTone",
              "colorBias",
              "skinTone",
              "lightingScene",
              "workflow",
              "intensity",
              "author"
            ]
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "look": {
      "type": "object",
      "description": "Editable HSL-style look values used by generated LUT records and fallback previews.",
      "properties": {
        "exposure": {
          "type": "number"
        },
        "contrast": {
          "type": "number"
        },
        "saturation": {
          "type": "number"
        },
        "luminance": {
          "type": "number"
        },
        "temperature": {
          "type": "number"
        },
        "tint": {
          "type": "number"
        },
        "hueShift": {
          "type": "number"
        },
        "shadowLift": {
          "type": "number"
        },
        "highlightRollOff": {
          "type": "number"
        },
        "redSaturation": {
          "type": "number"
        },
        "greenSaturation": {
          "type": "number"
        },
        "blueSaturation": {
          "type": "number"
        }
      }
    },
    "cloudProvider": {
      "type": "string",
      "examples": [
        "iCloud Drive",
        "OneDrive",
        "Dropbox",
        "Local Folder"
      ]
    },
    "relativePath": {
      "type": "string"
    },
    "fileHash": {
      "type": "string",
      "description": "SHA-256 hash of the exact imported LUT file bytes, prefixed with sha256:."
    },
    "contentHash": {
      "type": "string",
      "description": "SHA-256 hash of normalized LUT numeric data, ignoring title, comments, and whitespace."
    },
    "lutSize": {
      "type": "integer",
      "description": "3D LUT cube size, such as 17, 33, or 65."
    },
    "sourceFileSize": {
      "type": "integer",
      "description": "Original imported file size in bytes."
    },
    "importedAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
